# ---------------------------------------------------------------------------
# bg-rise-alert configuration. Copy to .env and edit, or set these as real
# environment variables on whatever runs the watcher.
# ---------------------------------------------------------------------------

# --- Nightscout ------------------------------------------------------------
NIGHTSCOUT_URL=https://nightscout-niknewys.herokuapp.com
# Only needed if your site requires auth to read entries.
# NIGHTSCOUT_TOKEN=
# API_SECRET=
# auto | mmol | mgdl. 'auto' reads the units your site displays; yours reports
# mmol/L, so every threshold and message below is in mmol/L.
UNITS=auto

# --- How you get told ------------------------------------------------------
# Comma separated: console, twilio, pushover, webhook
NOTIFIER=console

# Real SMS via Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111
# TWILIO_TO=+15550002222          # comma separate for several recipients

# Push notification via Pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# PUSHOVER_SOUND=climb

# Any HTTP endpoint. An IFTTT Webhooks URL works as-is: the JSON body carries
# value1 (title), value2 (detail) and value3 (link) alongside named fields.
# WEBHOOK_URL=https://maker.ifttt.com/trigger/bg_rising/with/key/YOUR_KEY
# WEBHOOK_METHOD=POST

# --- When to alert ---------------------------------------------------------
# Rise thresholds, in mmol/L per 5 minutes - the same number Nightscout shows
# next to your BG. Defaults: 0.7 (rising) and 1.2 (rapid) for mmol/L.
# RISE_PER_5MIN=0.7
# RAPID_PER_5MIN=1.2

# Never remind below this BG, in mmol/L. Default 4.4, so a climb out of a
# hypo is left alone.
# MIN_BG=4.4

# Optional: only alert if BG (mmol/L) is already above this, or projected to
# reach it within PROJECT_MINS. 0 disables the check.
# ALERT_ABOVE=0
# PROJECT_MINS=30

# Don't wake me. Local time, may wrap past midnight. Empty = always on.
# QUIET_HOURS=23:00-07:00

# --- How often --------------------------------------------------------------
POLL_MINS=5
# Minimum gap between reminders.
COOLDOWN_MINS=45
# BG must stop rising for this long before the next climb counts as a new meal.
RESET_MINS=30
# Re-nudge if it is still climbing this long after the last reminder. 0 = never.
REPEAT_AFTER_MINS=120
# Send a second, louder reminder if a rise turns into a rapid one.
ESCALATE_TO_RAPID=true
ESCALATE_AFTER_MINS=20

# --- Trend detection --------------------------------------------------------
# Readings are fitted with a least-squares line, which copes with the noisy,
# irregularly spaced data xDrip uploads far better than a two-point delta.
WINDOW_MINS=20
FAST_WINDOW_MINS=10
MIN_READINGS=3
# Reject scatter that is not really a trend (0-1, higher is stricter).
MIN_R2=0.5
# Ignore CGM data older than this.
MAX_STALE_MINS=12

# --- Skip the reminder if you already bolused -------------------------------
# Only works if your insulin is logged to Nightscout treatments.
INSULIN_LOOKBACK_MINS=90
MIN_BOLUS_UNITS=0.5

# --- Misc -------------------------------------------------------------------
# Where the cooldown state lives. Defaults to .state.json next to the project.
# STATE_FILE=/var/lib/bg-rise-alert/state.json
# REQUEST_TIMEOUT_MS=15000
